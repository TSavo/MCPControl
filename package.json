{
  "name": "mcp-control",
  "version": "0.4.0",
  "description": "Cross-platform desktop automation server for the Model Context Protocol (MCP)",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-control": "build/index.js"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "!build/**/*.test.js",
    "!build/**/*.test.d.ts",
    "!build/providers/keysender",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TSavo/MCPControl.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "automation",
    "desktop",
    "mouse",
    "keyboard",
    "screenshot",
    "robotjs",
    "claude",
    "ai"
  ],
  "author": "TSavo",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:all": "node scripts/build.js",
    "start": "node build/index.js",
    "dev": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"test/**/*.js\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.21",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "clipboardy": "^5.0.2",
    "sharp": "^0.34.3",
    "ulid": "^3.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/express": "^5.0.2",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitest/coverage-v8": "^4.0.17",
    "audit-ci": "^7.1.0",
    "eslint": "^9.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^4.0.17"
  }
}
